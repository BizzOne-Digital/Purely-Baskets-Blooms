# -----------------------------------------------------------------------------
# Purely Baskets & Blooms — environment template
# Copy to `.env.local` and fill in your values:
#   copy .env.example .env.local   (Windows)
#   cp .env.example .env.local     (macOS/Linux)
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string (required for DB, admin, and seed scripts)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/pbb?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth (required for /admin login)
# Generate AUTH_SECRET: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Public site URL (storefront links, emails, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin user created by: npm run seed-admin
ADMIN_EMAIL=admin@purelybasketsandblooms.com
ADMIN_PASSWORD=change-this-password

# Optional: order / contact notifications (defaults to ADMIN_EMAIL)
# ADMIN_NOTIFICATION_EMAIL=

# Cloudinary (admin product uploads — optional for local shop demo)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Gmail SMTP (order emails — optional for local dev)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_APP_PASSWORD=
# MAIL_FROM=

# Stripe (optional)
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
